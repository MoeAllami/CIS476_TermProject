// Collection: users
{
  _id: ObjectId, // Automatically generated by MongoDB
  name: String,
  email: String, // Should be unique
  password: String, // Hashed password
  securityQuestions: [
    {
      question: String,
      answer: String // Should store hashed answers in production
    }
  ],
  profileImage: String, // URL to image
  phoneNumber: String,
  address: {
    street: String,
    city: String,
    state: String,
    zipCode: String,
    country: String
  },
  driverLicense: {
    number: String,
    expiryDate: Date,
    isVerified: Boolean
  },
  balance: Number, // User's account balance for payments
  createdAt: Date,
  updatedAt: Date
}

